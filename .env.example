# =============================================================================
# HBS AI Institute — Command Center environment variables
# Copy this file to `.env` and fill in the keys you actually have.
# Every integration in config.yaml degrades gracefully (logs + stubs a
# result) when its key is missing, so you can boot the system with zero
# keys configured and add integrations incrementally.
# =============================================================================

# --- Anthropic (Claude Pro subscription / included API access) -------------
ANTHROPIC_API_KEY=

# --- Google AI Studio (free tier) -------------------------------------------
GOOGLE_AI_STUDIO_API_KEY=

# --- Perplexity (free tier / Pro-included) ----------------------------------
PERPLEXITY_API_KEY=

# --- GitHub (persistent memory sync + PR/code sync) -------------------------
GITHUB_TOKEN=
GITHUB_REPO=khedderman/hbs

# --- Notion (long-term organizational memory) -------------------------------
NOTION_API_KEY=
NOTION_MEMORY_DATABASE_ID=

# --- Airtable (pipeline & activity tracking) --------------------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PIPELINE_TABLE=Pipeline

# --- Optional multimedia integrations (disabled by default in config.yaml) --
ELEVENLABS_API_KEY=
