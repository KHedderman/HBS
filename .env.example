# =============================================================================
# HBS AI Institute — Command Center environment variables
# Copy this file to `.env` and fill in the keys you actually have.
# Every integration in config.yaml degrades gracefully (logs + stubs a
# result) when its key is missing, so you can boot the system with zero
# keys configured and add integrations incrementally.
# =============================================================================

# --- Anthropic ---------------------------------------------------------------
# ONLY needed if you want the STANDALONE SCRIPT (main.py) to make real
# calls instead of its default offline stub. This is Anthropic's metered,
# pay-per-token Developer API (console.anthropic.com) — a separate paid
# product from a claude.ai Pro/Max subscription, which has no portable
# API key. Talking to Eliot in this chat, and The Docket website, need
# NO key here at all. Leave this blank unless you deliberately want
# billed API usage.
ANTHROPIC_API_KEY=

# --- Google AI Studio ----------------------------------------------------
# Genuinely free: aistudio.google.com/apikey, rate-limited, no billing
# unless you separately turn billing on for the project.
GOOGLE_AI_STUDIO_API_KEY=

# --- Perplexity ------------------------------------------------------------
# NOT reliably free — a metered API. Perplexity Pro has historically
# included a small monthly API credit, but check current terms before
# assuming any usage here is covered by your subscription.
PERPLEXITY_API_KEY=

# --- GitHub (persistent memory sync + PR/code sync) -------------------------
GITHUB_TOKEN=
GITHUB_REPO=khedderman/hbs

# --- Notion (long-term organizational memory) -------------------------------
NOTION_API_KEY=
NOTION_MEMORY_DATABASE_ID=

# --- Airtable (pipeline & activity tracking) --------------------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PIPELINE_TABLE=Pipeline

# --- Optional multimedia integrations (disabled by default in config.yaml) --
ELEVENLABS_API_KEY=
